# ── Build outputs ───────────────────────────────────────────
**/build/
build/

# ── Gradle ──────────────────────────────────────────────────
.gradle/
gradle/wrapper/gradle-wrapper.jar

# ── Kotlin Multiplatform caches ─────────────────────────────
.kotlin/

# ── IDE — IntelliJ / Android Studio ─────────────────────────
# Ignore everything except the few project-level files worth sharing
.idea/*
!.idea/.name
!.idea/gradle.xml
!.idea/compiler.xml
!.idea/kotlinc.xml
!.idea/misc.xml
!.idea/.gitignore

# ── Module metadata ─────────────────────────────────────────
*.iml

# ── Local properties (SDK paths, machine-specific) ──────────
local.properties

# ── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Android-specific ────────────────────────────────────────
/captures
.externalNativeBuild
.cxx
*.apk
*.aab
*.ap_
*.dex

# ── Release signing ──────────────────────────────────────────
*.keystore
*.jks

# ── iOS / Xcode (if iosApp module is added later) ──────────
MQiosApp/Pods/
iosApp/*.xcworkspace/xcuserdata/
iosApp/*.xcodeproj/xcuserdata/
iosApp/*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcuserstate

# ── Firebase config (contains project-specific keys) ──────
# Uncomment below if you don't want to track these in git:
# composeApp/google-services.json
# iosApp/iosApp/GoogleService-Info.plist

# ── Claude Code local config ───────────────────────────────
.claude/
